# OpenRouter API Key - Get yours at https://openrouter.ai/keys
# REPLACE THIS WITH YOUR ACTUAL KEY (starts with sk-or-v1-)
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# Optional: Default model (can be overridden by frontend)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Optional: Your site URL for OpenRouter headers
SITE_URL=http://localhost:5173

# Optional: Your site name for OpenRouter headers
SITE_NAME=AI Educational Assistant

# Optional: Server port
PORT=3001