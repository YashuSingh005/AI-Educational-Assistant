# OpenRouter API Key - Get yours at https://openrouter.ai/keys
# REPLACE THIS WITH YOUR ACTUAL KEY (starts with sk-or-v1-)
VITE_OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# API URL for the chat API endpoint
# For local development with Vite proxy: /api
# For local backend directly: http://localhost:3001
# For Vercel deployment: https://your-vercel-app.vercel.app/api
VITE_API_URL=/api

# ============================================
# BACKEND ENVIRONMENT VARIABLES (Set in Vercel Dashboard for backend project)
# ============================================
# OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
# SITE_URL=https://your-frontend.vercel.app
# SITE_NAME=AI Chatbot